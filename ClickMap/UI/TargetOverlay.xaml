<Window x:Class="ClickMap.UI.TargetOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Topmost="True" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Background="#40000000" Cursor="Cross" FontFamily="{StaticResource Font.Ui}">
    <Grid>
        <Canvas x:Name="RootCanvas">
            <!-- Full-screen crosshair that follows the cursor until a point is picked -->
            <Line x:Name="CrossH" Stroke="{StaticResource B.Orange}" StrokeThickness="1"
                  StrokeDashArray="4 4" Opacity="0.8" IsHitTestVisible="False" />
            <Line x:Name="CrossV" Stroke="{StaticResource B.Orange}" StrokeThickness="1"
                  StrokeDashArray="4 4" Opacity="0.8" IsHitTestVisible="False" />

            <!-- Marker shown at the picked point -->
            <Grid x:Name="Marker" Width="36" Height="36" Visibility="Collapsed" IsHitTestVisible="False">
                <Ellipse Stroke="{StaticResource B.Orange}" StrokeThickness="2" Fill="#26FF8A1E" />
                <Rectangle Width="14" Height="2" Fill="{StaticResource B.Orange}" />
                <Rectangle Width="2" Height="14" Fill="{StaticResource B.Orange}" />
            </Grid>

            <Border x:Name="CoordTip" Background="#E6101216"
                    BorderBrush="{StaticResource B.Orange}" BorderThickness="1"
                    CornerRadius="5" Padding="7,3" IsHitTestVisible="False">
                <TextBlock x:Name="CoordText" Foreground="{StaticResource B.Text}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </Canvas>

        <!-- Guidance banner, centered near the top -->
        <Border x:Name="Banner" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0"
                Background="#E6101216" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                CornerRadius="10" Padding="18,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/ClickMap.png" Width="26" Height="26" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel>
                    <TextBlock x:Name="InstructionText" Foreground="{StaticResource B.Text}"
                               FontSize="14" FontWeight="SemiBold"
                               Text="Click where the mouse click should land" />
                    <TextBlock Foreground="{StaticResource B.TextMuted}" FontSize="12" Margin="0,2,0,0"
                               Text="Press Esc to cancel" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
